# Hunter.io (email finder + verifier). Free tier is small: results are cached in data/db.json.
HUNTER_API_KEY=
# Neo4j AuraDB Free (optional: the graph also runs in memory)
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
# Flexprice usage-based billing (optional: usage is also counted locally)
FLEXPRICE_API_KEY=
# Region your Flexprice tenant lives in: us (default) https://us.api.flexprice.io/v1, eu https://eu.api.flexprice.io/v1, india https://api.cloud.flexprice.io/v1
FLEXPRICE_API_URL=https://us.api.flexprice.io/v1
FLEXPRICE_CUSTOMER_ID=demo-founder
# Starting credits for enrichment in the demo
CREDITS=50
